# LinkedIn Agent Suite Environment Configuration
APP_ENV=development
DATA_DIR=data
LOGS_DIR=data/logs

# Browser Configuration
BROWSER_HEADLESS=true
BROWSER_USER_DATA_DIR=data/browser_profile
BROWSER_SLOW_MO_MS=50
BROWSER_TIMEOUT_MS=30000

# Official LinkedIn API
ENABLE_OFFICIAL_POSTING=false
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
LINKEDIN_API_VERSION=202609

# Safety & Approvals
REQUIRE_ACTION_CONFIRMATION=true
APPROVAL_HMAC_SECRET=

# LLM Intelligence Configuration
LLM_PROVIDER=mock
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Automatic Content Engine Guardrails
AUTOPUBLISH_ENABLED=false
MAX_POSTS_PER_DAY=2
ALLOWED_POSTING_START=8
ALLOWED_POSTING_END=18
MIN_CONTENT_SCORE=75.0
MIN_EVIDENCE_SCORE=80.0
TOPIC_COOLDOWN_DAYS=7
